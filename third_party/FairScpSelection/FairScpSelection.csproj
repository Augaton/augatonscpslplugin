<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FairScpSelection</RootNamespace>
    <LangVersion>11</LangVersion>
    <UseAugatonLib>false</UseAugatonLib>
    <UsePublicizedGame>true</UsePublicizedGame>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>0</WarningLevel>
    <NoWarn>$(NoWarn);CS0618;CS8632;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625;CS0169;CS0414;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
