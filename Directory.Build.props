<Project>

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType Condition=" '$(Configuration)' == 'Release' ">none</DebugType>
    <SL_REFERENCES Condition=" '$(SL_REFERENCES)' == '' ">$(MSBuildThisFileDirectory).references</SL_REFERENCES>
    <LabApiVersion>1.1.7</LabApiVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Northwood.LabAPI" Version="$(LabApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
