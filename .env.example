# A copier en .env, qui n'est jamais committe. Lu par tools/deploy.sh.
# Aucun mot de passe ici : sftp le demande, ou ajoutez votre cle SSH dans le panel.

# Adresse et port SFTP, indiques dans l'onglet Settings du serveur sur Pelican.
SFTP_HOST=panel.exemple.fr
SFTP_PORT=2022

# Nom d'utilisateur SFTP, de la forme utilisateur.identifiant sur Pelican.
SFTP_USER=utilisateur.1a2b3c4d

# Dossier LabAPI, relatif a la racine SFTP du serveur.
LABAPI_PATH=".config/SCP Secret Laboratory/LabAPI"
